<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>NeuralFlow</AssemblyName>
    <RootNamespace>NeuralFlow</RootNamespace>
    <Version>0.6.0</Version>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>../branding/NeuralFlow.ico</ApplicationIcon>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
  </PropertyGroup>
  <ItemGroup><None Include="../product.json" Link="product.json" CopyToOutputDirectory="PreserveNewest" /></ItemGroup>
  <ItemGroup><Resource Include="../branding/NeuralFlow.ico" Link="Branding/NeuralFlow.ico" /></ItemGroup>
  <ItemGroup><Using Remove="System.Windows.Forms"/><Using Remove="System.Drawing"/></ItemGroup>
</Project>
